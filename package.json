{
  "name": "mobx-react-observer",
  "version": "2.0.0",
  "description": "Automatic React observer for Mobx",
  "files": [
    "dist"
  ],
  "module": "./dist/esm/index.js",
  "main": "./dist/esm/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts",
      "require": "./dist/cjs/index.cjs"
    },
    "./vite-plugin": {
      "import": "./dist/esm/vite-plugin.js",
      "types": "./dist/esm/vite-plugin.d.ts",
      "require": "./dist/cjs/vite-plugin.cjs"
    }
  },
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "yarn clean && yarn build:cjs && yarn build:esm",
    "build:cjs": "tsc -p ./tsconfig.build-cjs.json && node renameToCjs.js",
    "build:esm": "tsc -p ./tsconfig.build-esm.json",
    "clean": "rimraf ./dist ./dist-babel-plugin ./dist-swc-plugin",
    "test": "vitest",
    "prepublish": "yarn build"
  },
  "keywords": [
    "react",
    "mobx",
    "observer"
  ],
  "author": "Christian Alfoni",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mobx-react-lite": "^4.1.0 || ^5.0.0",
    "vite-plugin-observing-components": "^0.1.0"
  }
}
